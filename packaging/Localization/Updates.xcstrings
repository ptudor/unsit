    "Unsit %1$@ is available and requires macOS %2$@ or later." : {
      "comment" : "Message in the update sheet when a newer version exists but this Mac's system is too old for it. %1$@ is the app's version number such as 1.2.0; %2$@ is a macOS version number such as 13.0. Keep 'macOS' as written. 'Unsit' is the app's name; keep it exactly as written, in Latin letters.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsit %1$@ is beskikbaar en vereis macOS %2$@ of later."
