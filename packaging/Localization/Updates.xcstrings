    "Downloaded and verified. Quit Unsit, then drag the new app into Applications." : {
      "comment" : "Message in the update sheet after the new version was downloaded and its checksum verified. It tells the user how to install it: quit the app, then drag the new app icon from the opened disk image onto the Applications folder. 'Applications' is the macOS folder; use the name macOS shows for it in your language (for example 'Programme' in German). Use your language's macOS term for 'Quit'. 'Unsit' is the app's name; keep it exactly as written, in Latin letters.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afgelaai en geverifieer. Sluit Unsit, sleep dan die nuwe toepassing na Toepassings."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወርዶ ተረጋግጧል። Unsit አቋርጡ፣ ከዚያም አዲሱን መተግበሪያ ወደ Applications ይጎትቱት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التنزيل والتحقق. أغلق Unsit ، ثم اسحب التطبيق الجديد إلى مجلد التطبيقات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükləndi və təsdiqləndi. Unsit-dən çıxın, sonra yeni tətbiqi Tətbiqlərə sürüşdürün."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спампавана і праверана. Выйдзіце з Unsit і перацягніце новую праграму ў Праграмы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излезте от „Unsit“, после плъзнете новото приложение в „Приложения“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড এবং যাচাই করা হয়েছে। Unsit বন্ধ করুন, তারপর নতুন অ্যাপটি অ্যাপ্লিকেশনস ফোল্ডারে ড্র্যাগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarregat i verificat. Sortiu de Unsit i arrossegueu la nova aplicació a Aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor byl stažen a ověřen. Ukončete aplikaci „Unsit“ a poté novou aplikaci přetáhněte do složky „Aplikace“."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wedi'i lawrlwytho a'i wirio. Gadewch Unsit, yna llusgwch yr ap newydd i Gymwysiadau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadet og verificeret. Afslut »Unsit«, og træk derefter den nye app over i mappen »Programmer«."
          }
        },
        "de" : {
          "stringUnit" : {
