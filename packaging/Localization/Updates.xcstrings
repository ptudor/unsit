        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzeto i provjereno. Zatvorite Unsit, a zatim povucite novu aplikaciju u Aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letöltve és ellenőrizve. Zárja be az „Unsit” alkalmazást, majd húzza az új alkalmazást az „Alkalmazások” mappába."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ներբեռնված ու ստուգված է։ Փակեք Unsit-ը, ապա նոր հավելվածը քաշեք «Ծրագրեր» պանակ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah diunduh dan diverifikasi. Tutup Unsit, lalu seret aplikasi baru ke folder Aplikasi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sótt og staðfest. Hættu að nota Unsit og dragðu síðan nýja forritið inn í Forrit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaricato e verificato. Esci da Unsit, quindi trascina la nuova app nella cartella Applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードして確認しました。「Unsit」を終了し、新しいアプリを「アプリケーション」フォルダにドラッグしてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩამოტვირთული და შემოწმებულია. გამოდით Unsit-იდან, შემდეგ ახალი აპი გადაიტანეთ Applications-ში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жүктеліп алынды және тексерілді. Unsit бағдарламасынан шығыңыз, содан кейін жаңа қолданбаны Қолданбалар бөліміне сүйреп апарыңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បានទាញយក និងផ្ទៀងផ្ទាត់។ ចាកចេញពី Unsit រួចអូសកម្មវិធីថ្មីទៅថតកម្មវិធី។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿದೆ ಮತ್ತು ಪರಿಶೀಲಿಸಲಾಗಿದೆ. Unsit ನಿರ್ಗಮಿಸಿ, ನಂತರ ಹೊಸ ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಎಳೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드하고 확인했습니다. Unsit를 종료한 다음, 새 앱을 응용 프로그램 폴더로 끌어다 놓으세요."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жүктөлүп, текшерилди. Unsit'тен чыгып, жаңы колдонмону Колдонмолорго сүйрөңүз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ດາວໂຫຼດ ແລະ ຢືນຢັນແລ້ວ. ອອກຈາກ Unsit, ຈາກນັ້ນລາກແອັບໃໝ່ໄປໃສ່ແອັບພລິເຄຊັນ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsisiųsta ir patikrinta. Uždarykite „Unsit“, tada naują programą perkelkite į aplanką „Programos“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejupielādēts, pārbaudīts. Aizveriet Unsit un velciet jauno lietotni uz mapi Applications."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преземено и потврдено. Излезете од Unsit , а потоа повлечете ја новата апликација во „Апликации“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഡൗൺലോഡ് ചെയ്ത് പരിശോധിച്ചുറപ്പിച്ചു. Unsit പുറത്തുകടക്കുക, തുടർന്ന് പുതിയ ആപ്പ് ആപ്ലിക്കേഷനുകളിലേക്ക് വലിച്ചിടുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Татаж аваад баталгаажуулсан. Unsit-ээс гараад, шинэ аппликейшнийг Аппликейшн хавтас руу чирнэ үү."
          }
        },
        "mr" : {
          "stringUnit" : {
