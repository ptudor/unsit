        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 확인 시 GitHub에 연결합니다. 아카이브와 추출된 파일은 Mac에 그대로 남아 있습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текшерүү GitHub'га туташат. Архивдериңиз, чыгарылган файлдарыңыз Mac'иңизде калат."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການກວດສອບຕິດຕໍ່ GitHub. ໄຟລ໌ບີບອັດ ແລະ ໄຟລ໌ທີ່ແຕກອອກຍັງຢູ່ໃນ Mac ຂອງທ່ານ."
          }
        },
        "lt" : {
          "stringUnit" : {
