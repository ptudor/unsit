        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଡାଉନଲୋଡ୍ ଏବଂ ଯାଞ୍ଚ ହୋଇଛି। Unsit ବନ୍ଦ କରନ୍ତୁ, ତାପରେ ନୂତନ ଆପ୍ଲିକେସନ୍‌କୁ ଆପ୍ଲିକେସନ୍‌ ଫୋଲ୍ଡରେ ଟାଣନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਡਾਊਨਲੋਡ ਅਤੇ ਪ੍ਰਮਾਣਿਤ ਕੀਤਾ ਗਿਆ। Unsit ਨੂੰ ਬੰਦ ਕਰੋ, ਫਿਰ ਨਵੀਂ ਐਪ ਨੂੰ ਐਪਲੀਕੇਸ਼ਨਾਂ ਵਿੱਚ ਖਿੱਚੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
