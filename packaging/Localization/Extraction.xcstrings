    "Archive damage detected; no files recovered" : {
      "comment" : "Result headline for one archive in the list: the archive is damaged and nothing could be salvaged from it. A short headline with no final period. 'Archive' means a compressed file container (like a .zip file) - here an old StuffIt .sit file - not a records archive, an archive room, or a backup. 'Recover' is the data-recovery sense: salvaging whatever is still readable from a damaged archive.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argiefskade opgespoor; geen lêers herwin nie"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የማህደር ጉዳት ተገኝቷል፤ ምንም ፋይሎች አልተመለሱም"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف تلف في الأرشيف؛ لم يتم استعادة أي ملفات"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxiv zədəsi aşkarlandı; heç bir fayl bərpa olunmadı"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выяўлена пашкоджанне архіва; файлы не адноўлены"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установена е повреда в архива; не са възстановени файлове"
