    "%lld files found beyond damaged records; folder placement is uncertain." : {
      "comment" : "Note under a damaged archive's result. When part of the archive's internal index is damaged, the app keeps scanning past the damage and still finds files, but can no longer tell which folder they belonged in, so it saves them in separate recovery folders. %lld is the number of such files. 'Records' are the archive's internal index entries (file and folder headers) - not documents, and not music records.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file found beyond damaged records; folder placement is uncertain."
                }
              },
              "other" : {
                "stringUnit" : {
