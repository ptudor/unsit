    "Unsit recovered %lld files despite archive damage" : {
      "comment" : "Result headline for one archive: the archive is damaged, but the app still salvaged %lld files from it. The app is deliberately named as the subject, to credit it with the rescue. No final period. 'Unsit' is the app's name; keep it exactly as written, in Latin letters. 'Recover' is the data-recovery sense: salvaging whatever is still readable from a damaged archive. 'Archive' means a compressed file container (like a .zip file) - here an old StuffIt .sit file - not a records archive, an archive room, or a backup.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unsit recovered %lld file despite archive damage"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unsit recovered %lld files despite archive damage"
                }
              }
            }
          }
        },
        "af" : {
          "variations" : {
            "plural" : {
              "one" : {
