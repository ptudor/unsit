    "The extractor did not return a valid recovery report." : {
      "comment" : "Line added to an archive's Details when the app's built-in extraction tool ('the extractor', a helper program inside the app) ended without producing its machine-readable summary of what was saved. 'Recovery report' is that summary.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
